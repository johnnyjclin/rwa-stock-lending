# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local credentials must never be committed; only the blank template is public.
.env*
!.env.example

# Local security scan reports and Hardhat output
gitleaks-report*
/artifacts/
/cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
