# Local-only database. The application selects the rwa_lending database.
MONGODB_URI=mongodb://127.0.0.1:27017/rwa_lending

# Server-only sandbox credentials. Never add NEXT_PUBLIC_ to these settings.
ALPACA_BROKER_API_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY_ID=
ALPACA_BROKER_SECRET_KEY=
ETHEREUM_RPC_URL=
TOKEN_AGENT_PRIVATE_KEY=
CLAIM_ISSUER_SIGNING_KEY=

# ERC-3643 / OnchainID: use your own compatible test deployment.
TOKEN_ADDRESS=
IDENTITY_FACTORY_ADDRESS=
IDENTITY_IMPLEMENTATION_AUTHORITY=
IDENTITY_REGISTRY=
CLAIM_ISSUER_CONTRACT=
KYC_CLAIM_TOPIC=
ADMIN_ADDRESSES=

# Optional registry addresses used by diagnostics.
CLAIM_TOPICS_REGISTRY=
TRUSTED_ISSUERS_REGISTRY=

# Public browser configuration only: never put credentials or personal data here.
# Match the server-side token and network configuration.
NEXT_PUBLIC_TSPY_ADDRESS=
NEXT_PUBLIC_COMET_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_TSTOCK_PRICE_FEED_ADDRESS=
NEXT_PUBLIC_SELF_APP_NAME=RWA Demo
NEXT_PUBLIC_SELF_SCOPE=
NEXT_PUBLIC_SELF_ENDPOINT=

# Optional legacy contract tooling; use disposable test accounts only.
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# Earlier contract experiments on compound-test.
USDC_ADDRESS=
SPY_PRICE_FEED=
